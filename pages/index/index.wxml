<view class="container">
  <!-- Hero Section -->
  <view class="hero-section">
    <view class="hero-icon">🔮</view>
    <view class="hero-title">九型人格</view>
    <view class="hero-subtitle">探索真实的自己，理解深层的动机</view>
  </view>

  <!-- Introduction Card -->
  <view class="card intro-card">
    <view class="title">什么是九型人格？</view>
    <view class="subtitle">
      九型人格（Enneagram）是一种描述人类性格类型的系统，将人格分为九种基本类型。它帮助我们了解自己的核心动机、恐惧和行为模式，从而促进个人成长和人际关系的发展。
    </view>
  </view>

  <!-- Stats Section -->
  <view class="stats-row">
    <view class="stat-item">
      <view class="stat-number">9</view>
      <view class="stat-label">人格类型</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">36</view>
      <view class="stat-label">测试题目</view>
    </view>
    <view class="stat-item">
      <view class="stat-number">3min</view>
      <view class="stat-label">测试时长</view>
    </view>
  </view>

  <!-- Quick Action -->
  <view class="card action-card">
    <view class="action-title">🎯 开始你的探索之旅</view>
    <view class="action-desc">通过36道专业题目，发现属于你的核心人格类型</view>
    <button class="btn-primary start-btn" bindtap="startTest">
      立即测试
    </button>
  </view>

  <!-- Type Preview -->
  <view class="section-title">九种人格类型</view>
  <view class="type-grid">
    <view class="type-item" wx:for="{{types}}" wx:key="id" bindtap="goToTypes">
      <view class="type-icon" style="background: {{item.color}}20; color: {{item.color}}">
        {{item.icon}}
      </view>
      <view class="type-name">{{item.name}}</view>
      <view class="type-num">{{item.id}}号</view>
    </view>
  </view>

  <!-- Feature Cards -->
  <view class="section-title">功能特色</view>
  <view class="feature-list">
    <view class="feature-item">
      <view class="feature-icon">📊</view>
      <view class="feature-content">
        <view class="feature-title">专业测评</view>
        <view class="feature-desc">基于经典九型人格理论设计的36道专业测试题</view>
      </view>
    </view>
    <view class="feature-item">
      <view class="feature-icon">📚</view>
      <view class="feature-content">
        <view class="feature-title">详细解析</view>
        <view class="feature-desc">深入了解每种人格类型的特征、优势与成长方向</view>
      </view>
    </view>
    <view class="feature-item">
      <view class="feature-icon">💡</view>
      <view class="feature-content">
        <view class="feature-title">自我觉察</view>
        <view class="feature-desc">帮助你认识自己，理解行为背后的深层动机</view>
      </view>
    </view>
  </view>
</view>
