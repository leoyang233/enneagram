.detail-header {
  margin: -30rpx -30rpx 30rpx;
  padding: 60rpx 30rpx;
  color: white;
}

.header-content {
  text-align: center;
}

.type-icon-large {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.type-name {
  font-size: 48rpx;
  font-weight: bold;
  margin-bottom: 8rpx;
}

.type-english {
  font-size: 28rpx;
  opacity: 0.9;
  margin-bottom: 8rpx;
}

.type-num {
  font-size: 24rpx;
  opacity: 0.8;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.overview-text {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.8;
  margin-bottom: 24rpx;
}

.keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.keyword {
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  font-weight: 500;
}

.motivation-card {
  background: linear-gradient(135deg, #FFF9E6, #FFF5D6);
}

.motivation-content {
  font-size: 30rpx;
  color: var(--text-color);
  line-height: 1.8;
  font-style: italic;
}

.trait-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.trait-item {
  display: flex;
  align-items: center;
}

.trait-icon {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.trait-text {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.5;
}

.growth-tips {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.tip-item {
  display: flex;
  align-items: flex-start;
}

.tip-num {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.tip-text {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
  flex: 1;
}

.relationship-tips {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.rel-section {
  background: #F8F8F8;
  padding: 24rpx;
  border-radius: 12rpx;
}

.rel-title {
  font-size: 28rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.rel-text {
  font-size: 26rpx;
  color: var(--light-text);
  line-height: 1.6;
}

.famous-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.famous-item {
  background: #F0F0F0;
  padding: 16rpx 32rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: var(--text-color);
}

.nav-section {
  margin: 40rpx 0;
}

.nav-title {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 20rpx;
  margin-left: 10rpx;
}

.type-nav {
  white-space: nowrap;
}

.nav-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 30rpx;
  margin-right: 16rpx;
  background: white;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.nav-item.active {
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.15);
}

.nav-icon {
  font-size: 40rpx;
  margin-bottom: 8rpx;
}

.nav-name {
  font-size: 24rpx;
}

.test-cta {
  margin: 40rpx 0 60rpx;
}

.test-cta .btn-primary {
  width: 100%;
}
