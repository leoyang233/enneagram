.header {
  text-align: center;
  padding: 20rpx 0 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: var(--light-text);
}

.type-list {
  margin-bottom: 40rpx;
}

.type-card {
  background: white;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  position: relative;
}

.type-main {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.type-left {
  display: flex;
  align-items: center;
}

.type-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.type-name {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 4rpx;
}

.type-english {
  font-size: 24rpx;
  color: var(--light-text);
}

.type-number {
  font-size: 60rpx;
  font-weight: bold;
  opacity: 0.3;
}

.type-desc {
  font-size: 26rpx;
  color: var(--light-text);
  line-height: 1.5;
  margin-bottom: 20rpx;
}

.type-keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.keyword {
  background: #F5F5F5;
  color: var(--light-text);
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  font-size: 22rpx;
}

.arrow {
  position: absolute;
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 32rpx;
  color: #CCCCCC;
  opacity: 0;
  transition: opacity 0.2s;
}

.type-card:active .arrow {
  opacity: 1;
}

.quick-test {
  margin-bottom: 60rpx;
}

.quick-test .btn-primary {
  font-size: 28rpx;
}
