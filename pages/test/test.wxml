<view class="container">
  <!-- Progress Header -->
  <view class="progress-header">
    <view class="progress-info">
      <text class="progress-text">问题 {{currentIndex + 1}} / {{totalQuestions}}</text>
      <text class="progress-percent">{{progressPercent}}%</text>
    </view>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progressPercent}}%"></view>
    </view>
  </view>

  <!-- Question Card -->
  <view class="question-card" wx:if="{{currentQuestion}}">
    <view class="question-number">Q{{currentIndex + 1}}</view>
    <view class="question-text">{{currentQuestion.text}}</view>
    
    <!-- Options -->
    <view class="options">
      <view class="option-item {{answers[currentQuestion.id] === 5 ? 'selected' : ''}}" 
            bindtap="selectAnswer" data-score="5">
        <view class="option-radio">5</view>
        <view class="option-label">非常符合</view>
      </view>
      <view class="option-item {{answers[currentQuestion.id] === 4 ? 'selected' : ''}}" 
            bindtap="selectAnswer" data-score="4">
        <view class="option-radio">4</view>
        <view class="option-label">比较符合</view>
      </view>
      <view class="option-item {{answers[currentQuestion.id] === 3 ? 'selected' : ''}}" 
            bindtap="selectAnswer" data-score="3">
        <view class="option-radio">3</view>
        <view class="option-label">一般</view>
      </view>
      <view class="option-item {{answers[currentQuestion.id] === 2 ? 'selected' : ''}}" 
            bindtap="selectAnswer" data-score="2">
        <view class="option-radio">2</view>
        <view class="option-label">不太符合</view>
      </view>
      <view class="option-item {{answers[currentQuestion.id] === 1 ? 'selected' : ''}}" 
            bindtap="selectAnswer" data-score="1">
        <view class="option-radio">1</view>
        <view class="option-label">完全不符合</view>
      </view>
    </view>
  </view>

  <!-- Navigation Buttons -->
  <view class="nav-buttons">
    <button class="btn-nav btn-prev" bindtap="prevQuestion" wx:if="{{currentIndex > 0}}">
      上一题
    </button>
    <button class="btn-nav btn-next {{!answers[currentQuestion.id] ? 'disabled' : ''}}" 
            bindtap="nextQuestion"
            disabled="{{!answers[currentQuestion.id]}}">
      {{currentIndex < totalQuestions - 1 ? '下一题' : '查看结果'}}
    </button>
  </view>

  <!-- Question Dots -->
  <view class="question-dots">
    <view class="dot {{index === currentIndex ? 'active' : ''}} {{answers[question.id] ? 'answered' : ''}}" 
          wx:for="{{questions}}" 
          wx:for-item="question" 
          wx:key="id"
          bindtap="jumpToQuestion"
          data-index="{{index}}">
    </view>
  </view>

  <!-- Tip -->
  <view class="tip">
    💡 请根据你的真实感受作答，不要过度思考
  </view>
</view>
