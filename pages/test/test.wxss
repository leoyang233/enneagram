.container {
  padding-bottom: 60rpx;
}

.progress-header {
  margin-bottom: 30rpx;
}

.progress-info {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.progress-text {
  font-size: 28rpx;
  color: var(--light-text);
}

.progress-percent {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: bold;
}

.progress-bar {
  height: 12rpx;
  background: #E8E8E8;
  border-radius: 6rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, var(--primary-color), #8B7BB5);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.question-card {
  background: white;
  border-radius: 20rpx;
  padding: 50rpx 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  margin-bottom: 40rpx;
}

.question-number {
  font-size: 28rpx;
  color: var(--primary-color);
  font-weight: bold;
  margin-bottom: 20rpx;
}

.question-text {
  font-size: 36rpx;
  color: var(--text-color);
  line-height: 1.6;
  margin-bottom: 50rpx;
  font-weight: 500;
}

.options {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 30rpx;
  background: #F8F8F8;
  border-radius: 16rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s;
}

.option-item:active {
  background: #F0F0F0;
}

.option-item.selected {
  background: var(--primary-color);
  border-color: var(--primary-color);
}

.option-radio {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: white;
  color: var(--primary-color);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  font-weight: bold;
  margin-right: 24rpx;
}

.option-item.selected .option-radio {
  background: rgba(255, 255, 255, 0.9);
}

.option-label {
  font-size: 30rpx;
  color: var(--text-color);
}

.option-item.selected .option-label {
  color: white;
}

.nav-buttons {
  display: flex;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-nav {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 50rpx;
  font-size: 30rpx;
  border: none;
}

.btn-nav::after {
  border: none;
}

.btn-prev {
  background: #F0F0F0;
  color: var(--text-color);
}

.btn-next {
  background: linear-gradient(135deg, var(--primary-color), #8B7BB5);
  color: white;
}

.btn-next.disabled {
  opacity: 0.5;
}

.question-dots {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 30rpx;
  padding: 0 20rpx;
}

.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E0E0E0;
  transition: all 0.2s;
}

.dot.answered {
  background: #B8B8B8;
}

.dot.active {
  background: var(--primary-color);
  transform: scale(1.2);
}

.tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--light-text);
}
