.result-header {
  text-align: center;
  padding: 40rpx 0;
}

.result-badge {
  display: inline-block;
  background: linear-gradient(135deg, var(--primary-color), #8B7BB5);
  color: white;
  padding: 10rpx 30rpx;
  border-radius: 30rpx;
  font-size: 24rpx;
  margin-bottom: 30rpx;
}

.type-icon-large {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 80rpx;
  margin: 0 auto 24rpx;
}

.type-name-large {
  font-size: 52rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.type-english {
  font-size: 28rpx;
  color: var(--light-text);
  margin-bottom: 8rpx;
}

.type-number {
  font-size: 24rpx;
  color: var(--primary-color);
  font-weight: 500;
}

.card-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 24rpx;
}

.score-card {
  margin-bottom: 30rpx;
}

.score-bars {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.score-bar-item {
  display: flex;
  align-items: center;
}

.bar-label {
  width: 120rpx;
  font-size: 24rpx;
  color: var(--light-text);
}

.bar-container {
  flex: 1;
  height: 24rpx;
  background: #F0F0F0;
  border-radius: 12rpx;
  overflow: hidden;
  margin: 0 16rpx;
}

.bar-fill {
  height: 100%;
  border-radius: 12rpx;
  transition: width 0.5s ease;
}

.bar-value {
  width: 60rpx;
  font-size: 24rpx;
  color: var(--text-color);
  text-align: right;
  font-weight: 500;
}

.type-card {
  margin-bottom: 30rpx;
}

.type-header {
  margin-bottom: 20rpx;
}

.type-title {
  font-size: 32rpx;
  font-weight: bold;
  color: var(--text-color);
}

.keywords {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.keyword {
  background: #F5F5F5;
  color: var(--light-text);
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
  font-size: 26rpx;
}

.type-desc {
  font-size: 28rpx;
  color: var(--text-color);
  line-height: 1.6;
}

.traits-card {
  margin-bottom: 30rpx;
}

.traits-section {
  margin-bottom: 30rpx;
}

.traits-section:last-child {
  margin-bottom: 0;
}

.traits-title {
  font-size: 30rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.traits-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.trait-item {
  display: flex;
  align-items: center;
}

.trait-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  margin-right: 16rpx;
}

.trait-text {
  font-size: 28rpx;
  color: var(--text-color);
}

.motivation-card {
  margin-bottom: 30rpx;
  background: linear-gradient(135deg, #FFF9E6, #FFF5D6);
}

.motivation-text {
  font-size: 30rpx;
  color: var(--text-color);
  line-height: 1.6;
  font-style: italic;
}

.secondary-card {
  margin-bottom: 40rpx;
}

.secondary-info {
  display: flex;
  align-items: flex-start;
}

.secondary-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.secondary-name {
  font-size: 30rpx;
  font-weight: bold;
  color: var(--text-color);
  margin-bottom: 8rpx;
}

.secondary-desc {
  font-size: 26rpx;
  color: var(--light-text);
  line-height: 1.5;
}

.action-buttons {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.action-buttons .btn-primary,
.action-buttons .btn-secondary {
  width: 100%;
}

.share-tip {
  text-align: center;
  font-size: 24rpx;
  color: var(--light-text);
  margin-bottom: 40rpx;
}
